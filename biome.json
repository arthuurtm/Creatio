{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},

	"files": {
		"ignoreUnknown": true,
		"includes": [
			"apps/**",
			"packages/**",

			"!**/node_modules",
			"!**/dist",
			"!**/build",
			"!**/.turbo",
			"!**/coverage",
			"!**/.output",

			"!apps/web/public"
		]
	},

	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},

	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},

	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},

	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
