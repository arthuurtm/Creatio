{
	"extends": "@tsconfig/node22/tsconfig.json",
	"include": [
		"vite.config.*",
		"vitest.config.*",
		"cypress.config.*",
		"nightwatch.conf.*",
		"playwright.config.*",
		"src/types/**/*.d.ts"
	],
	"compilerOptions": {
		"composite": true,
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"typeRoots": ["./node_modules/@types", "./types"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"]
	}
}
